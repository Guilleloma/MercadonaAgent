# Variables de entorno (ejemplo)
# Copia este archivo como .env y rellena valores reales

# Entorno
APP_ENV=dev
APP_LANGUAGE=es

# Mercadona API (placeholders; validar durante I2)
MERCADONA_API_BASE=https://api.mercadona.com
MERCADONA_USERNAME=
MERCADONA_PASSWORD=

# Red/Timeouts
HTTP_TIMEOUT_MS=10000
RETRY_MAX=3

# Automatización carrito Mercadona (Playwright)
# Código postal para seleccionar tienda/envío
MRC_POSTAL_CODE=
# Ejecutar navegador sin cabeza (false = ventana visible)
MRC_AUTOMATION_HEADLESS=false
# Mantener la ventana abierta N segundos tras añadir al carro (útil para revisar)
MRC_AUTOMATION_KEEP_OPEN_SECONDS=10
# Retraso (ms) entre acciones para fiabilidad
MRC_AUTOMATION_SLOW_MO_MS=150
# Ruta donde se guarda la sesión (login, CP) para reutilizarla
MRC_AUTOMATION_STORAGE=data/playwright_state.json
